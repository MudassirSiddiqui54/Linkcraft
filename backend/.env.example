# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
# Set a long random value in production. Used to encrypt/verify management credentials where applicable.
APP_SECRET=replace-with-at-least-32-random-characters
# Optional; leave unset to disable demo seed creation
SEED_DEMO=true
